# ==========================================================================
# CircleWork Africa — environment template
# Copy this file to `.env` and fill in real values.
# `.env` lives OUTSIDE the public web root and must NEVER be committed.
# ==========================================================================

# --- Application -----------------------------------------------------------
APP_NAME="CircleWork Africa"
APP_ENV=local
APP_DEBUG=true
# Base URL of the application. No trailing slash. No hardcoded localhost in code.
APP_URL="http://localhost/circlework/public"
APP_TIMEZONE="Africa/Lagos"
APP_LOCALE=en

# Secret used for signing internal tokens (CSRF pepper, remember-me, etc.)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY="change-me-to-a-64-character-random-hex-string"

# --- Database (MySQL / MariaDB) -------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=circlework
DB_USERNAME=circlework_user
DB_PASSWORD="change-me"
DB_CHARSET=utf8mb4

# --- Session / security ----------------------------------------------------
SESSION_NAME=circlework_session
# Set to 1 when the site is served over HTTPS only.
SESSION_SECURE_COOKIE=0
SESSION_LIFETIME=7200

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Email -----------------------------------------------------------------
# Driver: mail | smtp | log
# `log` writes messages to storage/logs/mail.log (safe default for local dev).
MAIL_DRIVER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="CircleWork Africa"

# Used only when MAIL_DRIVER=smtp
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=""
MAIL_SMTP_PASSWORD=""
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_AUTH=1

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
PORTFOLIO_MAX_BYTES=2097152

# --- Storage paths (relative to the project root) --------------------------
STORAGE_PATH=storage
PRIVATE_DOCUMENTS_PATH=storage/documents
PRIVATE_UPLOADS_PATH=storage/uploads
LOG_PATH=storage/logs

# --- Business defaults -----------------------------------------------------
DEFAULT_CURRENCY=NGN
DEFAULT_MARKETING_CITY=Kano
DEFAULT_MARKETING_STATE=Kano
